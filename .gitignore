# Whitelist: only source, tools, docs and research scripts are tracked.
# Data (Vanilla/, cache/, output/, research data, *.PML) stays out — it is large and derived from the game.
/*
!/.gitignore
!/*.slnx
!/global.json
!/Directory.Build.props
!/README.md
!/LICENSE
!/CHANGELOG.md
!/KNOWN_ISSUES.md
!/THIRD_PARTY_NOTICES.md
!/src/
!/tools/
!/docs/
!/research/

bin/
obj/
__pycache__/
*.user
/src/err.txt
/tools/scratch/
/docs/reference/

# research: scripts and notes two levels deep, no data
/research/*
!/research/*.py
!/research/*.md
!/research/*.ps1
!/research/*.sh
!/research/*/
/research/*/*
!/research/*/*.py
!/research/*/*.js
!/research/*/*.md
!/research/*/*.ps1
!/research/*/*.sh
!/research/*/*.atlaswh3
research/trees/tile_hf/

# 2026-10-05 repo clean-up (user): the program + the research on moving the build off BOB only.
# The 190 Expanded mod's own map work stays local.
/research/main190/
/research/guandu/*
!/research/guandu/hexgrid.py
!/research/guandu/rebuild_hex.py
!/research/guandu/hexfields.py
!/research/guandu/caime_3k_tilemap_issue.md
/docs/main190_*
/docs/north_regions_sources.md
/docs/proposals/
/tools/blender/
