<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AtlasWH3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by `AtlasWH3.Cli terry-schema` from the assembly kit's raw_data. -->
    <EmbeddedResource Include="Terry\Data\component_schema.json" LogicalName="AtlasWH3.component_schema.json" />
    <!-- Copy of assembly_kit/working_data/Terry/entity_configuration.xml (Terry's entity schema). -->
    <EmbeddedResource Include="Terry\Data\entity_configuration.xml" LogicalName="AtlasWH3.entity_configuration.xml" />
    <!-- Generated by `AtlasWH3.Cli db-schema-snapshot` from RPFM's schema_wh3.ron: the DB layouts AtlasWH3 reads. -->
    <EmbeddedResource Include="Db\Data\schema_wh3_snapshot.json" LogicalName="AtlasWH3.schema_wh3_snapshot.json" />
  </ItemGroup>

</Project>
