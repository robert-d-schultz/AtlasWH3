<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Atlas3K.Core\Atlas3K.Core.csproj" />
    <ProjectReference Include="..\Atlas3K.Formats\Atlas3K.Formats.csproj" />
    <ProjectReference Include="..\Atlas3K.Db\Atlas3K.Db.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Atlas3K</AssemblyName>
    <RootNamespace>Atlas3K.App</RootNamespace>
    <ApplicationIcon>Assets/atlas3k.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/atlas3k.ico" />
  </ItemGroup>

</Project>
