<Project>
  <!-- Product and version for every AtlasWH3 project; the About box and the start page read InformationalVersion. -->
  <PropertyGroup>
    <Product>AtlasWH3</Product>
    <Company>AtlasWH3</Company>
    <Copyright>Copyright (c) 2026 AtlasWH3 contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.2</VersionSuffix>
    <!-- appends +<commit> to InformationalVersion when built from git -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="AtlasWH3SourceRevision" BeforeTargets="GetAssemblyVersion;AddSourceRevisionToInformationalVersion" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AtlasWH3Revision" />
      <Output TaskParameter="ExitCode" PropertyName="_AtlasWH3GitExit" />
    </Exec>
    <!-- only a real commit id: without git on PATH the output is an error message -->
    <PropertyGroup Condition="'$(_AtlasWH3GitExit)' == '0'">
      <SourceRevisionId>$(_AtlasWH3Revision)</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
